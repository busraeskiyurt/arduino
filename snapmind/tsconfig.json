{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The node:test suite imports source files with explicit .ts extensions,
    // which is what `node --experimental-strip-types` requires.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
