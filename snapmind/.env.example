# Copy to .env for local development.
#
# The Gemini key is normally entered in Settings and stored in the device
# keychain. This variable is a development convenience only: values prefixed
# with EXPO_PUBLIC_ are inlined into the JS bundle and are readable by anyone
# who has the app, so do not ship a real key this way.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Without it, "Add to Google Tasks" copies the details and opens
# Google Tasks in the browser instead of creating the task through the API.
# Calendar and Maps actions need no sign-in at all.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
